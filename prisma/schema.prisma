generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idUsuario            Int                  @id @default(autoincrement()) @map("id_usuario")
  dni                  String               @unique @db.VarChar(20)
  nombre               String               @db.VarChar(100)
  apellido             String               @db.VarChar(100)
  telefono             String               @db.VarChar(30)
  email                String?              @unique @db.VarChar(150)
  passwordHash         String               @map("password_hash") @db.VarChar(255)
  primerLogin          Boolean              @default(true) @map("primer_login")
  intentosFallidos     Int                  @default(0) @map("intentos_fallidos")
  bloqueadoHasta       DateTime?            @map("bloqueado_hasta") @db.Timestamp(6)
  estado               EstadoActivo
  fechaAlta            DateTime             @map("fecha_alta") @db.Timestamp(6)
  administrativo       Administrativo?
  auditorias           Auditoria[]
  paciente             Paciente?
  profesional          Profesional?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  roles                UsuarioRol[]

  @@map("usuario")
}

model Rol {
  idRol       Int          @id @default(autoincrement()) @map("id_rol")
  nombre      String       @unique @db.VarChar(50)
  descripcion String?      @db.VarChar(255)
  usuarios    UsuarioRol[]

  @@map("rol")
}

model UsuarioRol {
  idUsuario       Int          @map("id_usuario")
  idRol           Int          @map("id_rol")
  estado          EstadoActivo
  fechaAsignacion DateTime     @map("fecha_asignacion") @db.Timestamp(6)
  rol             Rol          @relation(fields: [idRol], references: [idRol], onDelete: NoAction, onUpdate: NoAction)
  usuario         Usuario      @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@id([idUsuario, idRol])
  @@map("usuario_rol")
}

model RefreshToken {
  idRefreshToken  Int      @id @default(autoincrement()) @map("id_refresh_token")
  idUsuario       Int      @map("id_usuario")
  tokenHash       String   @unique @map("token_hash") @db.VarChar(255)
  fechaCreacion   DateTime @map("fecha_creacion") @db.Timestamp(6)
  fechaExpiracion DateTime @map("fecha_expiracion") @db.Timestamp(6)
  revocado        Boolean  @default(false)
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_token")
}

model PasswordResetToken {
  idPasswordResetToken Int      @id @default(autoincrement()) @map("id_password_reset_token")
  idUsuario            Int      @map("id_usuario")
  tokenHash            String   @unique @map("token_hash") @db.VarChar(255)
  fechaCreacion        DateTime @map("fecha_creacion") @db.Timestamp(6)
  fechaExpiracion      DateTime @map("fecha_expiracion") @db.Timestamp(6)
  utilizado            Boolean  @default(false)
  usuario              Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("password_reset_token")
}

model ObraSocial {
  idObraSocial Int          @id @default(autoincrement()) @map("id_obra_social")
  nombre       String       @unique @db.VarChar(100)
  descripcion  String?      @db.VarChar(255)
  estado       EstadoActivo
  planes       Plan[]

  @@map("obra_social")
}

model Plan {
  idPlan       Int          @id @default(autoincrement()) @map("id_plan")
  idObraSocial Int          @map("id_obra_social")
  nombre       String       @db.VarChar(100)
  descripcion  String?      @db.VarChar(255)
  estado       EstadoActivo
  pacientes    Paciente[]
  obraSocial   ObraSocial   @relation(fields: [idObraSocial], references: [idObraSocial], onDelete: NoAction, onUpdate: NoAction)

  @@map("plan")
}

model Paciente {
  idPaciente          Int                   @id @default(autoincrement()) @map("id_paciente")
  idUsuario           Int                   @unique @map("id_usuario")
  fechaNacimiento     DateTime              @map("fecha_nacimiento") @db.Date
  sexo                Sexo?
  idPlan              Int?                  @map("id_plan")
  estado              EstadoPaciente
  fechaRegistro       DateTime              @map("fecha_registro") @db.Timestamp(6)
  plan                Plan?                 @relation(fields: [idPlan], references: [idPlan], onDelete: NoAction, onUpdate: NoAction)
  usuario             Usuario               @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)
  responsables        PacienteResponsable[] @relation("PacienteDeResponsable")
  aCargoDe            PacienteResponsable[] @relation("ResponsableDePaciente")
  telefonoAlternativo String?               @map("telefono_alternativo") @db.VarChar(30)
  emailAlternativo    String?               @map("email_alternativo") @db.VarChar(150)
  turnos              Turno[]

  @@map("paciente")
}

model PacienteResponsable {
  idPaciente    Int                    @map("id_paciente")
  idResponsable Int                    @map("id_responsable")
  parentesco    String                 @db.VarChar(50)
  fechaInicio   DateTime               @map("fecha_inicio") @db.Date
  fechaFin      DateTime?              @map("fecha_fin") @db.Date
  estado        EstadoActivo
  documentos    DocumentoResponsable[]
  paciente      Paciente               @relation("PacienteDeResponsable", fields: [idPaciente], references: [idPaciente], onDelete: NoAction, onUpdate: NoAction)
  responsable   Paciente               @relation("ResponsableDePaciente", fields: [idResponsable], references: [idPaciente], onDelete: NoAction, onUpdate: NoAction)

  @@id([idPaciente, idResponsable])
  @@map("paciente_responsable")
}

model DocumentoResponsable {
  idDocumento      Int                 @id @default(autoincrement()) @map("id_documento")
  idPaciente       Int                 @map("id_paciente")
  idResponsable    Int                 @map("id_responsable")
  tipoDocumento    String              @map("tipo_documento") @db.VarChar(50)
  nombreArchivo    String              @map("nombre_archivo") @db.VarChar(255)
  rutaArchivo      String              @map("ruta_archivo") @db.VarChar(500)
  fechaCarga       DateTime            @map("fecha_carga") @db.Timestamp(6)
  estadoValidacion EstadoValidacion    @map("estado_validacion")
  observaciones    String?             @db.VarChar(500)
  intentos         Int                 @default(0)
  vinculo          PacienteResponsable @relation(fields: [idPaciente, idResponsable], references: [idPaciente, idResponsable], onDelete: NoAction, onUpdate: NoAction)

  @@map("documento_responsable")
}

model Profesional {
  idProfesional       Int                       @id @default(autoincrement()) @map("id_profesional")
  idUsuario           Int                       @unique @map("id_usuario")
  matricula           String                    @unique @db.VarChar(50)
  estado              EstadoActivo
  fechaAlta           DateTime                  @map("fecha_alta") @db.Date
  fechaBaja           DateTime?                 @map("fecha_baja") @db.Date
  usuario             Usuario                   @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)
  telefonoAlternativo String?                   @map("telefono_alternativo") @db.VarChar(30)
  emailAlternativo    String?                   @map("email_alternativo") @db.VarChar(150)
  especialidades      ProfesionalEspecialidad[]
  turnos              Turno[]
  agendas             AgendaProfesional[]

  @@map("profesional")
}

model Especialidad {
  idEspecialidad Int                       @id @default(autoincrement()) @map("id_especialidad")
  nombre         String                    @unique @db.VarChar(100)
  descripcion    String?                   @db.VarChar(255)
  estado         EstadoActivo
  profesionales  ProfesionalEspecialidad[]

  @@map("especialidad")
}

model ProfesionalEspecialidad {
  idProfesional   Int          @map("id_profesional")
  idEspecialidad  Int          @map("id_especialidad")
  fechaAsignacion DateTime     @map("fecha_asignacion") @db.Date
  estado          EstadoActivo
  especialidad    Especialidad @relation(fields: [idEspecialidad], references: [idEspecialidad], onDelete: NoAction, onUpdate: NoAction)
  profesional     Profesional  @relation(fields: [idProfesional], references: [idProfesional], onDelete: NoAction, onUpdate: NoAction)

  @@id([idProfesional, idEspecialidad])
  @@map("profesional_especialidad")
}

model AgendaProfesional {
  idAgendaProfesional  Int          @id @default(autoincrement()) @map("id_agenda_profesional")
  idProfesional        Int          @map("id_profesional")
  diaSemana            Int          @map("dia_semana") // 0: Domingo, 1: Lunes, 2: Martes, 3: Miércoles, 4: Jueves, 5: Viernes, 6: Sábado
  horaInicio           String       @map("hora_inicio") @db.VarChar(10) // Formato "HH:mm" (ej. "08:00")
  horaFin              String       @map("hora_fin") @db.VarChar(10)    // Formato "HH:mm" (ej. "17:00")
  duracionTurnoMinutos Int          @default(30) @map("duracion_turno_minutos")
  estado               EstadoActivo @default(ACTIVO)
  profesional          Profesional  @relation(fields: [idProfesional], references: [idProfesional], onDelete: NoAction, onUpdate: NoAction)

  @@map("agenda_profesional")
}

model Turno {
  idTurno           Int          @id @default(autoincrement()) @map("id_turno")
  idPaciente        Int          @map("id_paciente")
  idProfesional     Int          @map("id_profesional")
  fechaHora         DateTime     @map("fecha_hora") @db.Timestamp(6)
  estado            EstadoTurno  @default(SOLICITADO)
  motivoCancelacion String?      @map("motivo_cancelacion") @db.VarChar(500)
  consulta          Consulta?
  paciente          Paciente     @relation(fields: [idPaciente], references: [idPaciente], onDelete: NoAction, onUpdate: NoAction)
  profesional       Profesional  @relation(fields: [idProfesional], references: [idProfesional], onDelete: NoAction, onUpdate: NoAction)

  @@map("turno")
}

model Consulta {
  idConsulta       Int      @id @default(autoincrement()) @map("id_consulta")
  idTurno          Int      @unique @map("id_turno")
  diagnostico      String?  @db.Text
  tratamiento      String?  @db.Text
  notasAdicionales String?  @map("notas_adicionales") @db.Text
  fechaRealizacion DateTime @default(now()) @map("fecha_realizacion") @db.Timestamp(6)
  turno            Turno    @relation(fields: [idTurno], references: [idTurno], onDelete: NoAction, onUpdate: NoAction)

  @@map("consulta")
}

model Administrativo {
  idAdministrativo       Int          @id @default(autoincrement()) @map("id_administrativo")
  idUsuario              Int          @unique @map("id_usuario")
  puesto                 String       @db.VarChar(100)
  permisoGestionUsuarios Boolean      @default(false) @map("permiso_gestion_usuarios")
  estado                 EstadoActivo
  usuario                Usuario      @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)
  telefonoAlternativo    String?      @map("telefono_alternativo") @db.VarChar(30)
  emailAlternativo       String?      @map("email_alternativo") @db.VarChar(150)

  @@map("administrativo")
}

model Auditoria {
  idAuditoria        Int      @id @default(autoincrement()) @map("id_auditoria")
  idUsuario          Int?     @map("id_usuario")
  fechaHora          DateTime @map("fecha_hora") @db.Timestamp(6)
  accion             String   @db.VarChar(50)
  tablaAfectada      String   @map("tabla_afectada") @db.VarChar(100)
  idRegistroAfectado Int?     @map("id_registro_afectado")
  datosAnteriores    String?  @map("datos_anteriores")
  datosNuevos        String?  @map("datos_nuevos")
  ip                 String?  @db.VarChar(45)
  descripcion        String?  @db.VarChar(500)
  usuario            Usuario? @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("auditoria")
}

enum EstadoActivo {
  ACTIVO
  INACTIVO

  @@map("estado_activo")
}

enum EstadoPaciente {
  PENDIENTE_APROBACION
  ACTIVO
  RECHAZADO

  @@map("estado_paciente")
}

enum EstadoValidacion {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@map("estado_validacion")
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO

  @@map("sexo")
}

enum EstadoTurno {
  SOLICITADO
  CONFIRMADO
  REPROGRAMADO
  CANCELADO
  COMPLETADO

  @@map("estado_turno")
}
