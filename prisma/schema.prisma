generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // La url se resuelve vía prisma.config.ts + @prisma/adapter-pg (Prisma v7).
  // No va "url = env(...)" acá.
}

// ============================================================
// ENUMS
// ============================================================

enum EstadoActivo {
  ACTIVO
  INACTIVO

  @@map("estado_activo")
}

enum EstadoPaciente {
  PENDIENTE_APROBACION
  ACTIVO
  RECHAZADO

  @@map("estado_paciente")
}

enum EstadoValidacion {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@map("estado_validacion")
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO

  @@map("sexo")
}

// ============================================================
// USUARIO / ROL / AUTH
// ============================================================

model Usuario {
  idUsuario    Int          @id @default(autoincrement()) @map("id_usuario")
  dni          String       @unique @db.VarChar(20)
  nombre       String       @db.VarChar(100)
  apellido     String       @db.VarChar(100)
  telefono     String       @db.VarChar(30)
  email        String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  primerLogin  Boolean      @default(true) @map("primer_login")
  estado       EstadoActivo
  fechaAlta    DateTime     @map("fecha_alta")

  roles         UsuarioRol[]
  refreshTokens RefreshToken[]
  auditorias    Auditoria[]

  // Extensiones de rol: 0 o 1 fila en cada una (misma persona puede tener varias)
  paciente       Paciente?
  profesional    Profesional?
  administrativo Administrativo?

  @@map("usuario")
}

model Rol {
  idRol       Int     @id @default(autoincrement()) @map("id_rol")
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  usuarios UsuarioRol[]

  @@map("rol")
}

model UsuarioRol {
  idUsuario       Int          @map("id_usuario")
  idRol           Int          @map("id_rol")
  estado          EstadoActivo
  fechaAsignacion DateTime     @map("fecha_asignacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  rol     Rol     @relation(fields: [idRol], references: [idRol])

  @@id([idUsuario, idRol])
  @@map("usuario_rol")
}

model RefreshToken {
  idRefreshToken  Int      @id @default(autoincrement()) @map("id_refresh_token")
  idUsuario       Int      @map("id_usuario")
  tokenHash       String   @unique @map("token_hash") @db.VarChar(255)
  fechaCreacion   DateTime @map("fecha_creacion")
  fechaExpiracion DateTime @map("fecha_expiracion")
  revocado        Boolean  @default(false)

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("refresh_token")
}

// ============================================================
// OBRA SOCIAL / PLAN
// ============================================================

model ObraSocial {
  idObraSocial Int          @id @default(autoincrement()) @map("id_obra_social")
  nombre       String       @unique @db.VarChar(100)
  descripcion  String?      @db.VarChar(255)
  estado       EstadoActivo

  planes Plan[]

  @@map("obra_social")
}

model Plan {
  idPlan       Int          @id @default(autoincrement()) @map("id_plan")
  idObraSocial Int          @map("id_obra_social")
  nombre       String       @db.VarChar(100)
  descripcion  String?      @db.VarChar(255)
  estado       EstadoActivo

  obraSocial ObraSocial @relation(fields: [idObraSocial], references: [idObraSocial])
  pacientes  Paciente[]

  @@map("plan")
}

// ============================================================
// PACIENTE / RESPONSABLES
// ============================================================

model Paciente {
  idPaciente      Int            @id @default(autoincrement()) @map("id_paciente")
  idUsuario       Int            @unique @map("id_usuario")
  fechaNacimiento DateTime       @map("fecha_nacimiento") @db.Date
  sexo            Sexo
  idPlan          Int?           @map("id_plan")
  estado          EstadoPaciente
  fechaRegistro   DateTime       @map("fecha_registro")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  plan    Plan?   @relation(fields: [idPlan], references: [idPlan])

  // Vínculos donde este paciente es el MENOR (tiene responsables)
  responsables PacienteResponsable[] @relation("PacienteDeResponsable")
  // Vínculos donde este paciente ES responsable de otros (adulto a cargo)
  aCargoDe     PacienteResponsable[] @relation("ResponsableDePaciente")

  @@map("paciente")
}

model PacienteResponsable {
  idPaciente    Int          @map("id_paciente")
  idResponsable Int          @map("id_responsable")
  parentesco    String       @db.VarChar(50)
  fechaInicio   DateTime     @map("fecha_inicio") @db.Date
  fechaFin      DateTime?    @map("fecha_fin") @db.Date
  estado        EstadoActivo

  paciente    Paciente @relation("PacienteDeResponsable", fields: [idPaciente], references: [idPaciente])
  responsable Paciente @relation("ResponsableDePaciente", fields: [idResponsable], references: [idPaciente])

  documentos DocumentoResponsable[]

  @@id([idPaciente, idResponsable])
  @@map("paciente_responsable")
}

model DocumentoResponsable {
  idDocumento      Int              @id @default(autoincrement()) @map("id_documento")
  idPaciente       Int              @map("id_paciente")
  idResponsable    Int              @map("id_responsable")
  tipoDocumento    String           @map("tipo_documento") @db.VarChar(50)
  nombreArchivo    String           @map("nombre_archivo") @db.VarChar(255)
  rutaArchivo      String           @map("ruta_archivo") @db.VarChar(500)
  fechaCarga       DateTime         @map("fecha_carga")
  estadoValidacion EstadoValidacion @map("estado_validacion")
  observaciones    String?          @db.VarChar(500)

  vinculo PacienteResponsable @relation(fields: [idPaciente, idResponsable], references: [idPaciente, idResponsable])

  @@map("documento_responsable")
}

// ============================================================
// PROFESIONAL / ESPECIALIDAD
// ============================================================

model Profesional {
  idProfesional Int          @id @default(autoincrement()) @map("id_profesional")
  idUsuario     Int          @unique @map("id_usuario")
  matricula     String       @unique @db.VarChar(50)
  estado        EstadoActivo
  fechaAlta     DateTime     @map("fecha_alta") @db.Date
  fechaBaja     DateTime?    @map("fecha_baja") @db.Date

  usuario        Usuario                   @relation(fields: [idUsuario], references: [idUsuario])
  especialidades ProfesionalEspecialidad[]

  @@map("profesional")
}

model Especialidad {
  idEspecialidad Int          @id @default(autoincrement()) @map("id_especialidad")
  nombre         String       @unique @db.VarChar(100)
  descripcion    String?      @db.VarChar(255)
  estado         EstadoActivo

  profesionales ProfesionalEspecialidad[]

  @@map("especialidad")
}

model ProfesionalEspecialidad {
  idProfesional   Int          @map("id_profesional")
  idEspecialidad  Int          @map("id_especialidad")
  fechaAsignacion DateTime     @map("fecha_asignacion") @db.Date
  estado          EstadoActivo

  profesional  Profesional  @relation(fields: [idProfesional], references: [idProfesional])
  especialidad Especialidad @relation(fields: [idEspecialidad], references: [idEspecialidad])

  @@id([idProfesional, idEspecialidad])
  @@map("profesional_especialidad")
}

// ============================================================
// ADMINISTRATIVO
// ============================================================

model Administrativo {
  idAdministrativo       Int          @id @default(autoincrement()) @map("id_administrativo")
  idUsuario              Int          @unique @map("id_usuario")
  puesto                 String       @db.VarChar(100)
  permisoGestionUsuarios Boolean      @default(false) @map("permiso_gestion_usuarios")
  estado                 EstadoActivo

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("administrativo")
}

// ============================================================
// AUDITORÍA
// ============================================================

model Auditoria {
  idAuditoria        Int      @id @default(autoincrement()) @map("id_auditoria")
  idUsuario          Int?     @map("id_usuario")
  fechaHora          DateTime @map("fecha_hora")
  accion             String   @db.VarChar(50)
  tablaAfectada      String   @map("tabla_afectada") @db.VarChar(100)
  idRegistroAfectado Int?     @map("id_registro_afectado")
  datosAnteriores    String?  @map("datos_anteriores")
  datosNuevos        String?  @map("datos_nuevos")
  ip                 String?  @db.VarChar(45)
  descripcion        String?  @db.VarChar(500)

  usuario Usuario? @relation(fields: [idUsuario], references: [idUsuario])

  @@map("auditoria")
}
